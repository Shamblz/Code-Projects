{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": false,
    "isolatedModules": false,
    "jsx": "preserve"
  },
  "include": ["server.ts", "src/server/**/*.ts", "src/game/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/app/**", "src/components/**", "src/client/**"]
}
